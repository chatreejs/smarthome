# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# typescript build artifacts
*.tsbuildinfo

# runtime config — only config/web/config.example.js is committed;
# real config files are copied from it locally and never tracked
/config/web/config.*.js
!/config/web/config.example.js

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
